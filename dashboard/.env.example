# AYO Dashboard deployment env (template — no secrets)
# Copy to .env.local or paste into Coolify / Vercel.

NEXT_PUBLIC_SUPABASE_URL=https://your-kong-domain
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://your-kong-domain
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

NEXT_PUBLIC_API_URL=https://your-agent-coolify-url
AGENT_API_URL=https://your-agent-coolify-url
NEXT_PUBLIC_BASE_URL=https://your-dashboard-url

NODE_ENV=production
PORT=3000
