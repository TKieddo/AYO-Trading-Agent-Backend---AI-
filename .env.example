# === Required ===
DEEPSEEK_API_KEY=sk-your-deepseek-key
EXCHANGE=okx

# === OKX (demo) ===
OKX_DEMO=true
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
OKX_LEVERAGE=10

# === Pair Hunter ===
ENABLE_PAIR_HUNTER=true
PAIR_HUNTER_TOP_N=5
PAIR_HUNTER_MIN_VOLATILITY=1.5
PAIR_HUNTER_IDEAL_VOLATILITY=3.0
PAIR_HUNTER_MAX_VOLATILITY=6.0
CRYPTO_ASSETS=BTC ETH SOL

# === Exits (mechanical TP/SL; agent does not manage exits) ===
AGENT_MANAGE_EXITS=false
TAKE_PROFIT_PERCENT=7
STOP_LOSS_PERCENT=7
MARGIN_PER_POSITION=100
DEFAULT_LEVERAGE=20
INTERVAL=15m

# === Supabase (Coolify self-hosted or cloud) ===
# Studio → Settings → API
SUPABASE_URL=https://your-kong-or-api-domain
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# === Optional IG (only if EXCHANGE=ig) ===
# IG_DEMO=true
# IG_API_KEY=
# IG_USERNAME=
# IG_PASSWORD=
# FOREX_ASSETS=EURUSD GBPUSD AUDUSD USDJPY

# === Runtime ===
API_HOST=0.0.0.0
APP_PORT=8080
PORT=8080
