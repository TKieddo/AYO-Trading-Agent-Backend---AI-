# === Required ===
DEEPSEEK_API_KEY=sk-your-deepseek-key
EXCHANGE=okx

# === OKX (demo) ===
OKX_DEMO=true
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
OKX_LEVERAGE=10

# === Pair Hunter ===
ENABLE_PAIR_HUNTER=true
PAIR_HUNTER_TOP_N=5
PAIR_HUNTER_MIN_VOLATILITY=1.0
PAIR_HUNTER_IDEAL_VOLATILITY=2.0
PAIR_HUNTER_MAX_VOLATILITY=3.5
PAIR_HUNTER_MIN_VOLUME_24H=50000000
PAIR_HUNTER_MIN_TREND_STRENGTH=25
CRYPTO_ASSETS=BTC ETH SOL

# === Exits (mechanical; agent does not manage exits) ===
AGENT_MANAGE_EXITS=false
INTERVAL=15m
# EXIT_MODE=atr derives the stop from volatility: stop = SL_ATR_MULT x ATR% of price
# (clamped to MIN/MAX_STOP_PRICE_PCT), target = TP_RR_RATIO x stop. Use "fixed" to fall
# back to TAKE_PROFIT_PERCENT / STOP_LOSS_PERCENT, which are margin ROI figures.
EXIT_MODE=atr
SL_ATR_MULT=2.0
TP_RR_RATIO=2.5
ATR_PERIOD=14
MIN_STOP_PRICE_PCT=0.6
MAX_STOP_PRICE_PCT=4.0
TAKE_PROFIT_PERCENT=25
STOP_LOSS_PERCENT=10
ENABLE_BREAKEVEN_STOP=true
BREAKEVEN_TRIGGER_R=1.0
ENABLE_TRAILING_STOP=true
TRAILING_STOP_ACTIVATION_R=1.5
TRAILING_STOP_DISTANCE_R=1.0

# === Position sizing ===
# "risk": notional solved from the stop distance so each trade risks the same USD.
# "margin": legacy fixed MARGIN_PER_POSITION.
POSITION_SIZING_MODE=risk
RISK_PER_TRADE_USD=3
RISK_PER_TRADE_PCT=0.5
MARGIN_PER_POSITION=30
DEFAULT_LEVERAGE=10
MAX_POSITIONS=3

# === Re-entry control (anti-chop) ===
REENTRY_COOLDOWN_MINUTES=45
LOSS_REENTRY_COOLDOWN_MINUTES=90
BLOCK_DIRECTION_FLIP=true

# === Skip DeepSeek when flat assets have no usable indicators (mechanical TP/SL still runs) ===
SKIP_LLM_WITHOUT_MARKET_DATA=true

# === Supabase (Coolify self-hosted or cloud) ===
# Studio → Settings → API
SUPABASE_URL=https://your-kong-or-api-domain
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# === OKX crypto + IG forex (Coolify) ===
# Set MULTI_EXCHANGE_MODE=true OR leave it false — multi-exchange auto-enables when
# OKX + IG credentials + FOREX_ASSETS are all present.
MULTI_EXCHANGE_MODE=true
# Pause all forex analysis/trading (set true again when IG API key allowance recovers)
ENABLE_FOREX=false
IG_DEMO=true
IG_API_KEY=
IG_USERNAME=
IG_PASSWORD=
# Optional preferred IG account / epic overrides
# IG_ACCOUNT_ID=
# IG_EPIC_MAP=EURUSD:CS.D.EURUSD.MINI.IP,GBPUSD:CS.D.GBPUSD.MINI.IP
FOREX_ASSETS=EURUSD GBPUSD AUDUSD USDJPY
# Forex-specific knobs (override crypto defaults for FX pairs only)
FOREX_INTERVAL=15m
FOREX_LEVERAGE=20
# FOREX_RISK_PER_TRADE_USD=5
# FOREX_EXIT_MODE=atr
# FOREX_SL_ATR_MULT=1.5
# FOREX_TP_RR_RATIO=2.0

# === Runtime ===
API_HOST=0.0.0.0
APP_PORT=8080
PORT=8080
